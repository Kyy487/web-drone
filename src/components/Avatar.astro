---
interface Props {
  name: string;
  img?: string;
  position?: string;
  zoom?: number;
}

const { name, img, position = "center", zoom = 1 } = Astro.props;
const initials = name
  .split(" ")
  .slice(0, 2)
  .map((w) => w[0])
  .join("")
  .toUpperCase();
---

{
  img ? (
    <div class="team-photo" style={`--pos:${position};--zoom:${zoom}`}>
      <img class="media square" src={img} alt={name} loading="lazy" decoding="async" />
    </div>
  ) : (
    <div class="avatar" role="img" aria-label={name}>
      {initials}
    </div>
  )
}